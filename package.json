{
  "name": "dsh-diary-memory",
  "version": "0.1.0",
  "description": "为 DSH 的陪伴与个人数字分身提供有温度、可演化的日记记忆、百炼检索和安全压缩。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/cyhddyx/dsh-diary-memory.git" },
  "homepage": "https://github.com/cyhddyx/dsh-diary-memory#readme",
  "bugs": { "url": "https://github.com/cyhddyx/dsh-diary-memory/issues" },
  "engines": { "node": ">=22.15", "dsh": "0.2.1-rc.3" },
  "files": ["lib", "src", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./compaction": "./lib/orchestrator.js",
    "./compaction/locale/*.json": "./locale/compaction/*.json",
    "./compaction/icon": "./icon.svg",
    "./tools": "./lib/tools.js",
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./tools/icon": "./icon.svg",
    "./bailian-client": "./lib/bailian-client.js",
    "./memory-store": "./lib/memory-store.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "better-sqlite3": "^12.4.1", "zod": "4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-session-projection": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
